{
  "color": {
    "$type": "color",
    "nav": {
      "rail": {
        "$description": "Fundo fixo da trilha de navegação.",
        "$value": "{color.gray.950}"
      },
      "panel": {
        "$description": "Fundo fixo do painel e da barra de conteúdo.",
        "$value": "{color.gray.900}"
      },
      "edge": {
        "$description": "Borda e divisor do conjunto fixo de navegação.",
        "$value": "{color.gray.800}"
      },
      "hover": {
        "$description": "Fundo de interação em hover no conjunto fixo.",
        "$value": "{color.gray.800}"
      },
      "text": {
        "$description": "Texto em repouso no conjunto fixo.",
        "$value": "{color.gray.300}"
      },
      "text-strong": {
        "$description": "Texto enfatizado ou em hover no conjunto fixo.",
        "$value": "{color.gray.100}"
      },
      "text-muted": {
        "$description": "Texto apagado e rótulos secundários no conjunto fixo.",
        "$value": "{color.gray.500}"
      },
      "current": {
        "$description": "Preenchimento da entrada corrente no conjunto fixo.",
        "$value": "{color.indigo.700}"
      },
      "current-text": {
        "$description": "Texto sobre a entrada corrente no conjunto fixo.",
        "$value": "{color.white}"
      },
      "accent": {
        "$description": "Acento, marcador e anel de foco do conjunto fixo.",
        "$value": "{color.indigo.300}"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "inset": {
      "$description": "Preenchimento interno de um contêiner.",
      "sm": { "$value": "{space.3}" },
      "md": { "$value": "{space.4}" },
      "lg": { "$value": "{space.6}" }
    },
    "gap": {
      "$description": "Distância entre itens irmãos.",
      "sm": { "$value": "{space.2}" },
      "md": { "$value": "{space.3}" },
      "lg": { "$value": "{space.5}" }
    },
    "section": {
      "$description": "Separação entre blocos de página.",
      "$value": "{space.8}"
    }
  },
  "radius": {
    "$type": "dimension",
    "control": {
      "$description": "Raio de controles interativos: botão, campo, seletor.",
      "$value": "{radius.md}"
    },
    "surface": {
      "$description": "Raio de superfícies elevadas: cartão, painel, menu.",
      "$value": "{radius.lg}"
    },
    "pill": { "$value": "{radius.full}" }
  },
  "elevation": {
    "$type": "shadow",
    "raised": { "$value": "{shadow.sm}" },
    "overlay": { "$value": "{shadow.md}" },
    "modal": { "$value": "{shadow.lg}" }
  },
  "text": {
    "body": {
      "family": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "size": { "$type": "dimension", "$value": "{font.size.3}" },
      "weight": { "$type": "fontWeight", "$value": "{font.weight.regular}" },
      "line-height": {
        "$type": "number",
        "$value": "{font.line-height.normal}"
      },
      "numeric": {
        "$type": "fontVariantNumeric",
        "$value": "{font.numeric.text}"
      }
    },
    "label": {
      "family": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "size": { "$type": "dimension", "$value": "{font.size.2}" },
      "weight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },
      "line-height": { "$type": "number", "$value": "{font.line-height.snug}" },
      "numeric": {
        "$type": "fontVariantNumeric",
        "$value": "{font.numeric.text}"
      }
    },
    "heading": {
      "family": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "size": { "$type": "dimension", "$value": "{font.size.5}" },
      "weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" },
      "line-height": {
        "$type": "number",
        "$value": "{font.line-height.tight}"
      },
      "numeric": {
        "$type": "fontVariantNumeric",
        "$value": "{font.numeric.text}"
      }
    },
    "data": {
      "$description": "Dado numérico: identificadores, contagens, valores em tabela. Algarismos tabulares e zero cortado.",
      "family": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "size": { "$type": "dimension", "$value": "{font.size.2}" },
      "weight": { "$type": "fontWeight", "$value": "{font.weight.regular}" },
      "line-height": { "$type": "number", "$value": "{font.line-height.snug}" },
      "numeric": {
        "$type": "fontVariantNumeric",
        "$value": "{font.numeric.data}"
      }
    },
    "counterfactual": {
      "$description": "Papel contrafactual de um valor: o que seria, e não o que é. Inclinado, para que a distinção não dependa só de cor.",
      "style": { "$type": "fontStyle", "$value": "{font.style.italic}" }
    },
    "control": {
      "$description": "Escala de tamanho de fonte por degrau (pequeno/médio/grande), para qualquer controle que declare `size` — nomeia um degrau de escala, não um papel; distinta de `text.label`, que nomeia papel de rótulo de UI.",
      "sm": { "$type": "dimension", "$value": "{font.size.1}" },
      "md": { "$type": "dimension", "$value": "{font.size.2}" },
      "lg": { "$type": "dimension", "$value": "{font.size.3}" }
    }
  }
}
