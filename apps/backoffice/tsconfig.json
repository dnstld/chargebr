{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "tests/**/*.ts", "*.ts"],
  "exclude": ["next-env.d.ts"]
}
