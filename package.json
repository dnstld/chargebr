{
  "name": "chargebr",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "collect": "node --import tsx src/collector/cli.ts",
    "test": "node --import tsx --test tests/collector/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run verify:types && pnpm run verify:format && pnpm run verify:lint && pnpm run verify:test",
    "verify:types": "pnpm -r exec tsc --noEmit",
    "verify:format": "biome format .",
    "verify:lint": "biome lint .",
    "verify:test": "vitest run --passWithNoTests --reporter=verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@fission-ai/openspec": "1.13.1",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
