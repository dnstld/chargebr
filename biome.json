{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": ["apps/**", "packages/**", "!**/storybook-static"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["next", "next/**"],
                    "message": "Pacote da biblioteca não pode importar framework de aplicação (rotas, servidor, convenção de páginas)."
                  },
                  {
                    "group": ["**/apps/**"],
                    "message": "Pacote da biblioteca não pode importar de uma aplicação do repositório."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
